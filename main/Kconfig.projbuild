# Build-profile switch for the PC Controller (presenter) application.
#
# The presenter profile is selected by layering sdkconfig.presenter.defaults
# (which sets CONFIG_PC_CONTROLLER_APP=y) on top of sdkconfig.defaults via
# SDKCONFIG_DEFAULTS. The default demo profile never sets this symbol, so it
# stays "n" there and main/CMakeLists.txt registers the unchanged default
# source set. See docs/software-design/pc-controller/requirements.md §2.
menu "PC Controller Application"
    config PC_CONTROLLER_APP
        bool "PC Controller (BLE HID presenter) application"
        default y
        help
            Build the PC Controller BLE HID presenter firmware instead of
            the default demo application.
endmenu

menu "BSP Display Options"
    config BSP_LCD_SWAP_BYTES
        bool "LCD byte swap for RGB565 (LVGL LE to SPI BE)"
        default y
        help
          ST7789 面板通过 SPI 接收大端 RGB565，LVGL 输出小端。
          大多数批次需要 swap_bytes=true（默认）。
          当前硬件批次实测需 false，通过 sdkconfig.defaults 覆盖。
          更换面板批次时需重新实测。
endmenu
